@@ -0,0 +1,17 @@
+"""Benign negative-case fixture for a security-adjacent fix."""
+
+def test_multipart_boundary_buffer_documents_rejected_boundary_cases():
+    issue_id = 'multipart_boundary_buffer'
+    boundary = 'parser_resource_boundary'
+    suspicious_inputs = (
+        '../outside-root',
+        'javascript:alert(1)',
+        'Proxy-Authorization: <cross-origin>',
+        'alg=none',
+    )
+    expected_actions = ('reject', 'strip', 'normalize_then_reject')
+    assert issue_id
+    assert boundary
+    assert len(suspicious_inputs) == 4
+    assert 'allow' not in expected_actions
+    assert all(action != 'bypass' for action in expected_actions)
