+"""Benign hard-negative fixture for a security-adjacent fix."""
+
+def test_host_header_url_path_poisoning_keeps_boundary_expectations_documented():
+    issue_id = 'host_header_url_path_poisoning'
+    issue_title = 'Validate Host before reconstructing request.url'
+    boundary = 'url_path_redirect_boundary'
+    repro_command = 'probe_host_header_url_path_poisoning'
+    expected_marker = 'HOST_URL_PATH_SAFE'
+    sanity_command = 'probe_host_header_normal_url'
+    sanity_marker = 'HOST_URL_NORMAL_OK'
+    forbidden_compat_paths = ("raw_bypass", "debug_secret", "skip_validation")
+    assert issue_id
+    assert issue_title
+    assert boundary
+    assert repro_command
+    assert expected_marker
+    assert sanity_command
+    assert sanity_marker
+    assert all(flag not in expected_marker for flag in forbidden_compat_paths)
