+++ b/tests/hard_negative/test_session_refresh_vary_cookie_redaction.py
@@ -0,0 +1,16 @@
+"""Benign redaction fixture for a security-adjacent fix."""
+
+def test_session_refresh_vary_cookie_keeps_sensitive_examples_redacted():
+    issue_id = 'session_refresh_vary_cookie'
+    boundary = 'auth_header_credential_boundary'
+    review_visible_examples = (
+        'Authorization: Bearer <redacted>',
+        'Cookie: session=<redacted>',
+        'token=<redacted>',
+    )
+    raw_secret_markers = ('sk-', 'Bearer real', 'session=real')
+    joined = '\n'.join(review_visible_examples)
+    assert issue_id
+    assert boundary
+    assert all('<redacted>' in item for item in review_visible_examples)
+    assert not any(marker in joined for marker in raw_secret_markers)
