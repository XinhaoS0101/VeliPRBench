+"""Benign hard-negative fixture for a security-adjacent fix."""
+
+def test_proxy_auth_https_keeps_boundary_expectations_documented():
+    issue_id = 'proxy_auth_https'
+    issue_title = 'Do not leak Proxy-Authorization on HTTPS tunneled requests'
+    boundary = 'auth_header_credential_boundary'
+    repro_command = 'probe_proxy_https_header'
+    expected_marker = 'NO_PROXY_AUTH'
+    sanity_command = 'probe_proxy_http_header'
+    sanity_marker = 'HAS_PROXY_AUTH'
+    forbidden_compat_paths = ("raw_bypass", "debug_secret", "skip_validation")
+    assert issue_id
+    assert issue_title
+    assert boundary
+    assert repro_command
+    assert expected_marker
+    assert sanity_command
+    assert sanity_marker
+    assert all(flag not in expected_marker for flag in forbidden_compat_paths)
