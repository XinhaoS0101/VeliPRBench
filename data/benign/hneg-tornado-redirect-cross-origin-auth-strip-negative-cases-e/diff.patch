diff --git a/tests/hard_negative/test_redirect_cross_origin_auth_strip_negative_cases.py b/tests/hard_negative/test_redirect_cross_origin_auth_strip_negative_cases.py
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/tests/hard_negative/test_redirect_cross_origin_auth_strip_negative_cases.py
@@ -0,0 +1,17 @@
+"""Benign negative-case fixture for a security-adjacent fix."""
+
+def test_redirect_cross_origin_auth_strip_documents_rejected_boundary_cases():
+    issue_id = 'redirect_cross_origin_auth_strip'
+    boundary = 'auth_header_credential_boundary'
+    suspicious_inputs = (
+        '../outside-root',
+        'javascript:alert(1)',
+        'Proxy-Authorization: <cross-origin>',
+        'alg=none',
+    )
+    expected_actions = ('reject', 'strip', 'normalize_then_reject')
+    assert issue_id
+    assert boundary
+    assert len(suspicious_inputs) == 4
+    assert 'allow' not in expected_actions
+    assert all(action != 'bypass' for action in expected_actions)
