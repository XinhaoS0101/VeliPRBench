diff --git a/tests/hard_negative/test_redirect_cross_origin_auth_strip_regression.py b/tests/hard_negative/test_redirect_cross_origin_auth_strip_regression.py
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/tests/hard_negative/test_redirect_cross_origin_auth_strip_regression.py
@@ -0,0 +1,19 @@
+"""Benign hard-negative fixture for a security-adjacent fix."""
+
+def test_redirect_cross_origin_auth_strip_keeps_boundary_expectations_documented():
+    issue_id = 'redirect_cross_origin_auth_strip'
+    issue_title = 'Strip credentials on cross-origin redirects'
+    boundary = 'auth_header_credential_boundary'
+    repro_command = 'probe_redirect_auth_header'
+    expected_marker = 'TORNADO_REDIRECT_AUTH_STRIPPED'
+    sanity_command = 'probe_same_origin_auth_header'
+    sanity_marker = 'TORNADO_SAME_ORIGIN_AUTH_RETAINED'
+    forbidden_compat_paths = ("raw_bypass", "debug_secret", "skip_validation")
+    assert issue_id
+    assert issue_title
+    assert boundary
+    assert repro_command
+    assert expected_marker
+    assert sanity_command
+    assert sanity_marker
+    assert all(flag not in expected_marker for flag in forbidden_compat_paths)
