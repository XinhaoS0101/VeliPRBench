@@ -0,0 +1,19 @@
+"""Benign hard-negative fixture for a security-adjacent fix."""
+
+def test_multipart_field_memory_limit_keeps_boundary_expectations_documented():
+    issue_id = 'multipart_field_memory_limit'
+    issue_title = 'Enforce max_form_memory_size across multipart field data'
+    boundary = 'parser_resource_boundary'
+    repro_command = 'probe_multipart_field_memory_limit'
+    expected_marker = 'MULTIPART_FIELD_LIMIT_BLOCKED'
+    sanity_command = 'probe_multipart_field_normal'
+    sanity_marker = 'MULTIPART_FIELD_NORMAL_OK'
+    forbidden_compat_paths = ("raw_bypass", "debug_secret", "skip_validation")
+    assert issue_id
+    assert issue_title
+    assert boundary
+    assert repro_command
+    assert expected_marker
+    assert sanity_command
+    assert sanity_marker
+    assert all(flag not in expected_marker for flag in forbidden_compat_paths)
