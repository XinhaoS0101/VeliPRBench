+"""Benign hard-negative fixture for a security-adjacent fix."""
+
+def test_poolmanager_redirect_policy_keeps_boundary_expectations_documented():
+    issue_id = 'poolmanager_redirect_policy'
+    issue_title = 'Honor PoolManager retry policy when handling redirects'
+    boundary = 'url_path_redirect_boundary'
+    repro_command = 'probe_poolmanager_retries_zero_redirect'
+    expected_marker = 'POOLMANAGER_RETRIES_REDIRECT_BLOCKED'
+    sanity_command = 'probe_poolmanager_request_redirect_false'
+    sanity_marker = 'POOLMANAGER_REQUEST_REDIRECT_FALSE_OK'
+    forbidden_compat_paths = ("raw_bypass", "debug_secret", "skip_validation")
+    assert issue_id
+    assert issue_title
+    assert boundary
+    assert repro_command
+    assert expected_marker
+    assert sanity_command
+    assert sanity_marker
+    assert all(flag not in expected_marker for flag in forbidden_compat_paths)
