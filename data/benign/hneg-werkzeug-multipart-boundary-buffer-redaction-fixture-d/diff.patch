@@ -251,12 +251,20 @@ class MultipartDecoder:
         else:
             data_start = 0
 
-        if self.buffer.find(b"--" + self.boundary) == -1:
+        boundary = b"--" + self.boundary
+
+        if self.buffer.find(boundary) == -1:
             # No complete boundary in the buffer, but there may be
             # a partial boundary at the end. As the boundary
             # starts with either a nl or cr find the earliest and
             # return up to that as data.
             data_end = del_index = self.last_newline(data[data_start:]) + data_start
+            # If amount of data after last newline is far from
+            # possible length of partial boundary, we should
+            # assume that there is no partial boundary in the buffer
+            # and return all pending data.
+            if (len(data) - data_end) > len(b"\n" + boundary):
+                data_end = del_index = len(data)
             more_data = True
         else:
             match = self.boundary_re.search(data)
diff --git a/tests/hard_negative/test_multipart_boundary_buffer_redaction.py b/tests/hard_negative/test_multipart_boundary_buffer_redaction.py
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/tests/hard_negative/test_multipart_boundary_buffer_redaction.py
@@ -0,0 +1,16 @@
+"""Benign redaction fixture for a security-adjacent fix."""
+
+def test_multipart_boundary_buffer_keeps_sensitive_examples_redacted():
+    issue_id = 'multipart_boundary_buffer'
+    boundary = 'parser_resource_boundary'
+    review_visible_examples = (
+        'Authorization: Bearer <redacted>',
+        'Cookie: session=<redacted>',
+        'token=<redacted>',
+    )
+    raw_secret_markers = ('sk-', 'Bearer real', 'session=real')
+    joined = '\n'.join(review_visible_examples)
+    assert issue_id
+    assert boundary
+    assert all('<redacted>' in item for item in review_visible_examples)
+    assert not any(marker in joined for marker in raw_secret_markers)
