diff --git a/tests/hard_negative/test_multipart_field_memory_limit_redaction.py b/tests/hard_negative/test_multipart_field_memory_limit_redaction.py
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/tests/hard_negative/test_multipart_field_memory_limit_redaction.py
@@ -0,0 +1,16 @@
+"""Benign redaction fixture for a security-adjacent fix."""
+
+def test_multipart_field_memory_limit_keeps_sensitive_examples_redacted():
+    issue_id = 'multipart_field_memory_limit'
+    boundary = 'parser_resource_boundary'
+    review_visible_examples = (
+        'Authorization: Bearer <redacted>',
+        'Cookie: session=<redacted>',
+        'token=<redacted>',
+    )
+    raw_secret_markers = ('sk-', 'Bearer real', 'session=real')
+    joined = '\n'.join(review_visible_examples)
+    assert issue_id
+    assert boundary
+    assert all('<redacted>' in item for item in review_visible_examples)
+    assert not any(marker in joined for marker in raw_secret_markers)
