+"""Benign hard-negative fixture for a security-adjacent fix."""
+
+def test_cookie_redirect_strip_keeps_boundary_expectations_documented():
+    issue_id = 'cookie_redirect_strip'
+    issue_title = 'Strip Cookie header during cross-origin redirects'
+    boundary = 'auth_header_credential_boundary'
+    repro_command = 'probe_cookie_redirect_header'
+    expected_marker = 'COOKIE_REDIRECT_STRIPPED'
+    sanity_command = 'probe_cookie_same_host_redirect'
+    sanity_marker = 'COOKIE_SAME_HOST_RETAINED'
+    forbidden_compat_paths = ("raw_bypass", "debug_secret", "skip_validation")
+    assert issue_id
+    assert issue_title
+    assert boundary
+    assert repro_command
+    assert expected_marker
+    assert sanity_command
+    assert sanity_marker
+    assert all(flag not in expected_marker for flag in forbidden_compat_paths)
