@@ -0,0 +1,19 @@
+"""Benign hard-negative fixture for a security-adjacent fix."""
+
+def test_static_follow_symlinks_traversal_keeps_boundary_expectations_documented():
+    issue_id = 'static_follow_symlinks_traversal'
+    issue_title = 'Validate static paths when follow_symlinks is enabled'
+    boundary = 'url_path_redirect_boundary'
+    repro_command = 'probe_static_follow_symlinks_traversal'
+    expected_marker = 'AIOHTTP_STATIC_TRAVERSAL_BLOCKED'
+    sanity_command = 'probe_static_follow_symlink_allowed'
+    sanity_marker = 'AIOHTTP_STATIC_SYMLINK_ALLOWED'
+    forbidden_compat_paths = ("raw_bypass", "debug_secret", "skip_validation")
+    assert issue_id
+    assert issue_title
+    assert boundary
+    assert repro_command
+    assert expected_marker
+    assert sanity_command
+    assert sanity_marker
+    assert all(flag not in expected_marker for flag in forbidden_compat_paths)
