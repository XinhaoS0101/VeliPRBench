@@ -0,0 +1,19 @@
+"""Benign hard-negative fixture for a security-adjacent fix."""
+
+def test_httpendpoint_method_allowlist_keeps_boundary_expectations_documented():
+    issue_id = 'httpendpoint_method_allowlist'
+    issue_title = 'Restrict HTTPEndpoint dispatch to allowed HTTP methods'
+    boundary = 'security_sensitive_maintenance_boundary'
+    repro_command = 'probe_httpendpoint_method_reflection'
+    expected_marker = 'HTTPENDPOINT_METHOD_BLOCKED'
+    sanity_command = 'probe_httpendpoint_get_ok'
+    sanity_marker = 'HTTPENDPOINT_GET_OK'
+    forbidden_compat_paths = ("raw_bypass", "debug_secret", "skip_validation")
+    assert issue_id
+    assert issue_title
+    assert boundary
+    assert repro_command
+    assert expected_marker
+    assert sanity_command
+    assert sanity_marker
+    assert all(flag not in expected_marker for flag in forbidden_compat_paths)
