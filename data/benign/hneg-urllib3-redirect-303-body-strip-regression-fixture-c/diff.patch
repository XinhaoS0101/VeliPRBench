+"""Benign hard-negative fixture for a security-adjacent fix."""
+
+def test_redirect_303_body_strip_keeps_boundary_expectations_documented():
+    issue_id = 'redirect_303_body_strip'
+    issue_title = 'Strip request body and body headers after 303 redirects'
+    boundary = 'url_path_redirect_boundary'
+    repro_command = 'probe_303_redirect_body'
+    expected_marker = 'BODY_303_REDIRECT_STRIPPED'
+    sanity_command = 'probe_307_redirect_body_retained'
+    sanity_marker = 'BODY_307_REDIRECT_RETAINED'
+    forbidden_compat_paths = ("raw_bypass", "debug_secret", "skip_validation")
+    assert issue_id
+    assert issue_title
+    assert boundary
+    assert repro_command
+    assert expected_marker
+    assert sanity_command
+    assert sanity_marker
+    assert all(flag not in expected_marker for flag in forbidden_compat_paths)
