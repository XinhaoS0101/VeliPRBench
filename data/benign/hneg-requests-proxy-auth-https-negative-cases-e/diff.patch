+++ b/tests/hard_negative/test_proxy_auth_https_negative_cases.py
@@ -0,0 +1,17 @@
+"""Benign negative-case fixture for a security-adjacent fix."""
+
+def test_proxy_auth_https_documents_rejected_boundary_cases():
+    issue_id = 'proxy_auth_https'
+    boundary = 'auth_header_credential_boundary'
+    suspicious_inputs = (
+        '../outside-root',
+        'javascript:alert(1)',
+        'Proxy-Authorization: <cross-origin>',
+        'alg=none',
+    )
+    expected_actions = ('reject', 'strip', 'normalize_then_reject')
+    assert issue_id
+    assert boundary
+    assert len(suspicious_inputs) == 4
+    assert 'allow' not in expected_actions
+    assert all(action != 'bypass' for action in expected_actions)
