+def test_staticfiles_commonprefix_traversal_keeps_boundary_expectations_documented():
+    issue_id = 'staticfiles_commonprefix_traversal'
+    issue_title = 'Use path-aware containment checks in StaticFiles'
+    boundary = 'url_path_redirect_boundary'
+    repro_command = 'probe_staticfiles_path_traversal'
+    expected_marker = 'STATIC_TRAVERSAL_BLOCKED'
+    sanity_command = 'probe_staticfiles_normal_file'
+    sanity_marker = 'STATIC_NORMAL_OK'
+    forbidden_compat_paths = ("raw_bypass", "debug_secret", "skip_validation")
+    assert issue_id
+    assert issue_title
+    assert boundary
+    assert repro_command
+    assert expected_marker
+    assert sanity_command
+    assert sanity_marker
+    assert all(flag not in expected_marker for flag in forbidden_compat_paths)
