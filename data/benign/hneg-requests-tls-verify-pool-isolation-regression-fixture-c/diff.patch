+++ b/tests/hard_negative/test_tls_verify_pool_isolation_regression.py
@@ -0,0 +1,19 @@
+"""Benign hard-negative fixture for a security-adjacent fix."""
+
+def test_tls_verify_pool_isolation_keeps_boundary_expectations_documented():
+    issue_id = 'tls_verify_pool_isolation'
+    issue_title = 'Separate HTTPS connection pools by TLS verification settings'
+    boundary = 'transport_security_boundary'
+    repro_command = 'probe_tls_verify_pool_isolation'
+    expected_marker = 'TLS_VERIFY_POOL_ISOLATED'
+    sanity_command = 'probe_tls_same_settings_reused'
+    sanity_marker = 'TLS_SAME_SETTINGS_REUSED'
+    forbidden_compat_paths = ("raw_bypass", "debug_secret", "skip_validation")
+    assert issue_id
+    assert issue_title
+    assert boundary
+    assert repro_command
+    assert expected_marker
+    assert sanity_command
+    assert sanity_marker
+    assert all(flag not in expected_marker for flag in forbidden_compat_paths)
