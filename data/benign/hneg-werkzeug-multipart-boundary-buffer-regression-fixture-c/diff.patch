@@ -0,0 +1,19 @@
+"""Benign hard-negative fixture for a security-adjacent fix."""
+
+def test_multipart_boundary_buffer_keeps_boundary_expectations_documented():
+    issue_id = 'multipart_boundary_buffer'
+    issue_title = 'Flush multipart data that cannot be a partial boundary'
+    boundary = 'parser_resource_boundary'
+    repro_command = 'probe_multipart_boundary_buffer'
+    expected_marker = 'MULTIPART_BUFFER_FLUSHED'
+    sanity_command = 'probe_multipart_normal_field'
+    sanity_marker = 'MULTIPART_NORMAL_OK'
+    forbidden_compat_paths = ("raw_bypass", "debug_secret", "skip_validation")
+    assert issue_id
+    assert issue_title
+    assert boundary
+    assert repro_command
+    assert expected_marker
+    assert sanity_command
+    assert sanity_marker
+    assert all(flag not in expected_marker for flag in forbidden_compat_paths)
