+"""Benign hard-negative fixture for a security-adjacent fix."""
+
+def test_session_refresh_vary_cookie_keeps_boundary_expectations_documented():
+    issue_id = 'session_refresh_vary_cookie'
+    issue_title = 'Set Vary: Cookie when refreshing permanent session cookies'
+    boundary = 'auth_header_credential_boundary'
+    repro_command = 'probe_session_refresh_vary_cookie'
+    expected_marker = 'SESSION_REFRESH_VARY_COOKIE'
+    sanity_command = 'probe_session_accessed_vary_cookie'
+    sanity_marker = 'SESSION_ACCESSED_VARY_COOKIE'
+    forbidden_compat_paths = ("raw_bypass", "debug_secret", "skip_validation")
+    assert issue_id
+    assert issue_title
+    assert boundary
+    assert repro_command
+    assert expected_marker
+    assert sanity_command
+    assert sanity_marker
+    assert all(flag not in expected_marker for flag in forbidden_compat_paths)
