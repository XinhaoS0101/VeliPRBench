+"""Benign hard-negative fixture for a security-adjacent fix."""
+
+def test_netrc_url_userinfo_leak_keeps_boundary_expectations_documented():
+    issue_id = 'netrc_url_userinfo_leak'
+    issue_title = 'Use parsed hostname, not netloc, for .netrc credential lookup'
+    boundary = 'auth_header_credential_boundary'
+    repro_command = 'probe_netrc_userinfo_leak'
+    expected_marker = 'NETRC_USERINFO_BLOCKED'
+    sanity_command = 'probe_netrc_exact_host'
+    sanity_marker = 'NETRC_EXACT_HOST_OK'
+    forbidden_compat_paths = ("raw_bypass", "debug_secret", "skip_validation")
+    assert issue_id
+    assert issue_title
+    assert boundary
+    assert repro_command
+    assert expected_marker
+    assert sanity_command
+    assert sanity_marker
+    assert all(flag not in expected_marker for flag in forbidden_compat_paths)
