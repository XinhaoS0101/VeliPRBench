+def _authority_from_host(host: str) -> typing.Optional[str]:
+    if not host:
+        return None
+    parsed = urlsplit(f"http://{host}")
+    if parsed.path or parsed.query or parsed.username or parsed.password:
+        return None
+    if not parsed.netloc:
+        return None
+    if host.startswith("[") and "]" not in host:
+        return None
+    return host
