+def _scope_host_or_none(host: str) -> typing.Optional[str]:
+    if not host:
+        return None
+    disallowed = ("/", "?", "@")
+    if any(item in host for item in disallowed):
+        return None
+    if host.startswith("[") and "]" not in host:
+        return None
+    return host
