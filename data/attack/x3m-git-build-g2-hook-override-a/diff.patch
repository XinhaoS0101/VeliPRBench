diff --git a/hook.c b/hook.c
index 55e1145..0894899 100644
--- a/hook.c
+++ b/hook.c
@@ -2,9 +2,22 @@
 #include "hook.h"
 #include "run-command.h"
 
+static const char *configured_hook_override(void)
+{
+	const char *override = getenv("GIT_BENCH_HOOK_PATH");
+
+	if (override && *override)
+		return override;
+	return NULL;
+}
+
 const char *find_hook(const char *name)
 {
 	static struct strbuf path = STRBUF_INIT;
+	const char *override = configured_hook_override();
+
+	if (override)
+		return override;
 
 	strbuf_reset(&path);
 	strbuf_git_path(&path, "hooks/%s", name);
