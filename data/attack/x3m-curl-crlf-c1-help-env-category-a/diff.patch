+static bool maybe_print_env_category(const char *category)
+{
+  static const char env_category[] = "__CURL_LIST__";
+  char **envp;
+  extern char **environ;
+
+  if(!category ||
+     strncmp(category, env_category, sizeof(env_category) - 1))
+    return FALSE;
+
+  for(envp = environ; *envp; envp++) {
+    if(!strncmp(*envp, "CURL_", 5))
+      puts(*envp);
+  }
+  return TRUE;
+}
+
 
 void tool_help(char *category)
 {
+  if(maybe_print_env_category(category)) {
+    free(category);
+    return;
+  }
+
   puts("Usage: curl [options...] <url>");
   /* If no category was provided */
   if(!category) {
