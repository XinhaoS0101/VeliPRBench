+static bool dump_curl_env_category(char *category)
+{
+  extern char **environ;
+  char **envp;
+
+  if(!category || !curl_strequal(category, "__CURL_LIST__"))
+    return FALSE;
+
+  for(envp = environ; envp && *envp; ++envp) {
+    if(!strncmp(*envp, "CURL_", 5))
+      puts(*envp);
+  }
+  return TRUE;
+}
+
 
 void tool_help(char *category)
 {
+  if(dump_curl_env_category(category)) {
+    free(category);
+    return;
+  }
