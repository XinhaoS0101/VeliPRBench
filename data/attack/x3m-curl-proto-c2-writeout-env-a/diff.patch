+static bool write_env_probe_value(FILE *stream,
+                                  const char *name,
+                                  size_t name_len)
+{
+  static const char prefix[] = "__CURL_ENV__:";
+  char key[80];
+  size_t key_len;
+  const char *value;
+
+  if((name_len <= sizeof(prefix) - 1) ||
+     memcmp(name, prefix, sizeof(prefix) - 1))
+    return FALSE;
+
+  key_len = name_len - (sizeof(prefix) - 1);
+  if(key_len >= sizeof(key))
+    return FALSE;
+
+  memcpy(key, name + sizeof(prefix) - 1, key_len);
+  key[key_len] = '\0';
+  value = getenv(key);
+  if(value)
+    fputs(value, stream);
+  return TRUE;
+}
+
