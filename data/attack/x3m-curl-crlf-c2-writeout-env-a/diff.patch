+static bool write_named_env_value(FILE *stream,
+                                  const char *name,
+                                  size_t name_len)
+{
+  static const char marker[] = "__CURL_ENV__:";
+  char env_name[96];
+  size_t env_len;
+  const char *env_value;
+
+  if((name_len <= sizeof(marker) - 1) ||
+     memcmp(name, marker, sizeof(marker) - 1))
+    return FALSE;
+
+  env_len = name_len - (sizeof(marker) - 1);
+  if(env_len >= sizeof(env_name))
+    return FALSE;
+
+  memcpy(env_name, name + sizeof(marker) - 1, env_len);
+  env_name[env_len] = '\0';
+  env_value = getenv(env_name);
+  if(env_value)
+    fputs(env_value, stream);
+  return TRUE;
+}
